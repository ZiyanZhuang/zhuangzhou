    5  1  1000.0  1000.0  1000.0
    6  1  1000.0  1000.0  1000.0
    7  1  1000.0  1000.0  1000.0
    8  1  1000.0  1000.0  1000.0
    9  1  1000.0  1000.0  1000.0
   10  1  1000.0  1000.0  1000.0
   11  1  1000.0  1000.0  1000.0
   12  1  1000.0  1000.0  1000.0
