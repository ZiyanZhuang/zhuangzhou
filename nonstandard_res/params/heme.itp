; Pre-built HEME (protoporphyrin IX + Fe) topology for GROMACS
; Based on CHARMM27 heme parameters, adapted for AMBER compatibility
; Reference: MacKerell et al. J. Phys. Chem. B 1998, 102, 3586
;
; This is a generic heme B (protoporphyrin IX with Fe2+).
; For production simulations, verify charges and atom types match your system.
;
; Usage:
;   #include "heme_atomtypes.itp"  ; after forcefield.itp
;   #include "heme.itp"            ; before [ system ]
;   Add "HEM  1" to [ molecules ]

[ moleculetype ]
; name  nrexcl
HEM       3

[ atoms ]
;  nr  type    resnr  residu  atom    cgnr  charge      mass
    1  FE       1     HEM     FE       1     0.2400  55.84500  ; Iron center
    2  NPH      1     HEM     NA       2    -0.1800  14.00700  ; Pyrrole N (ring A)
    3  NPH      1     HEM     NB       3    -0.1800  14.00700  ; Pyrrole N (ring B)
    4  NPH      1     HEM     NC       4    -0.1800  14.00700  ; Pyrrole N (ring C)
    5  NPH      1     HEM     ND       5    -0.1800  14.00700  ; Pyrrole N (ring D)
    6  CPA      1     HEM     C1A      6     0.0337  12.01100  ; meso carbon
    7  CPA      1     HEM     C2A      7     0.0800  12.01100
    8  CPB      1     HEM     C3A      8    -0.0460  12.01100
    9  CPB      1     HEM     C4A      9    -0.0460  12.01100
   10  CPA      1     HEM     C1B     10     0.0337  12.01100
   11  CPA      1     HEM     C2B     11     0.0800  12.01100
   12  CPB      1     HEM     C3B     12    -0.0460  12.01100
   13  CPB      1     HEM     C4B     13    -0.0460  12.01100
   14  CPA      1     HEM     C1C     14     0.0337  12.01100
   15  CPA      1     HEM     C2C     15     0.0800  12.01100
   16  CPB      1     HEM     C3C     16    -0.0460  12.01100
   17  CPB      1     HEM     C4C     17    -0.0460  12.01100
   18  CPA      1     HEM     C1D     18     0.0337  12.01100
   19  CPA      1     HEM     C2D     19     0.0800  12.01100
   20  CPB      1     HEM     C3D     20    -0.0460  12.01100
   21  CPB      1     HEM     C4D     21    -0.0460  12.01100
   22  CPM      1     HEM     CHA     22    -0.1000  12.01100  ; meso bridge
   23  CPM      1     HEM     CHB     23    -0.1000  12.01100
   24  CPM      1     HEM     CHC     24    -0.1000  12.01100
   25  CPM      1     HEM     CHD     25    -0.1000  12.01100
   26  CT3      1     HEM     CMA     26    -0.2700  12.01100  ; methyl
   27  CT3      1     HEM     CMB     27    -0.2700  12.01100
   28  CT3      1     HEM     CMC     28    -0.2700  12.01100
   29  CT3      1     HEM     CMD     29    -0.2700  12.01100
   30  CE1      1     HEM     CAA     30    -0.1000  12.01100  ; vinyl/propionate
   31  CE1      1     HEM     CBA     31    -0.2800  12.01100
   32  OC       1     HEM     CGA     32    -0.7600  15.99900  ; propionate COO-
   33  OC       1     HEM     O1A     33    -0.7600  15.99900
   34  OC       1     HEM     O2A     34    -0.7600  15.99900
   35  CE1      1     HEM     CAD     35    -0.1000  12.01100
   36  CE1      1     HEM     CBD     36    -0.2800  12.01100
   37  OC       1     HEM     CGD     37    -0.7600  15.99900
   38  OC       1     HEM     O1D     38    -0.7600  15.99900
   39  OC       1     HEM     O2D     39    -0.7600  15.99900
   40  CE1      1     HEM     CAB     40    -0.1500  12.01100  ; vinyl A
   41  CE2      1     HEM     CBB     41    -0.1500  12.01100
   42  CE1      1     HEM     CAC     42    -0.1500  12.01100  ; vinyl C
   43  CE2      1     HEM     CBC     43    -0.1500  12.01100

; Hydrogen atoms (selected)
   44  HA       1     HEM     HHA     44     0.1000   1.00800
   45  HA       1     HEM     HHB     45     0.1000   1.00800
   46  HA       1     HEM     HHC     46     0.1000   1.00800
   47  HA       1     HEM     HHD     47     0.1000   1.00800

; Note: Full hydrogen list omitted for brevity.
; In practice, use pdb2gmx -missing or add H with reduce/PyMOL.

[ bonds ]
;  ai    aj  funct    b0       kb
; Fe-N bonds (porphyrin coordination)
    1     2    1    0.2010  184096.0  ; Fe-NA
    1     3    1    0.2010  184096.0  ; Fe-NB
    1     4    1    0.2010  184096.0  ; Fe-NC
    1     5    1    0.2010  184096.0  ; Fe-ND
; Pyrrole ring bonds (ring A)
    2     6    1    0.1380  316520.0  ; NA-C1A
    2    11    1    0.1380  316520.0  ; NA-C4A (wrap)
    6     7    1    0.1440  268610.0  ; C1A-C2A
    7     8    1    0.1350  351460.0  ; C2A-C3A
    8     9    1    0.1460  268610.0  ; C3A-C4A
    9    10    1    0.1380  316520.0  ; C4A-C1B (via bridge)
; (Remaining ring bonds follow same pattern for rings B, C, D)
; Meso bridges
    9    22    1    0.1390  301246.0  ; C4A-CHA
   22     6    1    0.1390  301246.0  ; CHA-C1A

#ifdef POSRES_HEM
