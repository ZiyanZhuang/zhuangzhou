; Production MD
define      = __DEFINE__
integrator  = md
nsteps      = __NSTEPS_MD__
dt          = 0.002
nstxout     = 0
nstvout     = 0
nstenergy   = 5000
nstlog      = 5000
nstxout-compressed = 5000
continuation    = yes
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4
nstlist         = 10
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
DispCorr        = EnerPres
pbc             = xyz
tcoupl      = V-rescale
tc-grps     = __TC_GRPS__
tau_t       = __TAU_T__
ref_t       = __REF_T__
pcoupl          = Parrinello-Rahman
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = __PRESSURE__
compressibility = 4.5e-5
gen_vel     = no
