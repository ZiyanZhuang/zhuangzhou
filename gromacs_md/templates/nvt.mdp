; NVT Equilibration (100 ps)
define      = __DEFINE__
integrator  = md
nsteps      = 50000
dt          = 0.002
nstxout     = 0
nstvout     = 0
nstenergy   = 500
nstlog      = 500
nstxout-compressed = 5000
continuation    = no
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4
nstlist         = 10
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
tcoupl      = V-rescale
tc-grps     = __TC_GRPS__
tau_t       = __TAU_T__
ref_t       = __REF_T__
pcoupl      = no
gen_vel     = yes
gen_temp    = __TEMP__
gen_seed    = -1
